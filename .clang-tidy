---
Checks: '
bugprone-*,
modernize-use-nullptr,
modernize-use-override,
cppcoreguidelines-*
-cppcoreguidelines-avoid-magic-numbers
'
WarningsAsErrors: ''
# Only analyze our own project code. This prevents noise and parse failures
# from system, ROS, or generated headers (e.g. inside /opt/ros, /usr, build/, install/).
HeaderFilterRegex: '(/rtest/|/examples/).*'